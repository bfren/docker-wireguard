#!/usr/bin/nu

use bf
use bf-s6
bf env load

# Bring up the WireGuard interface (oneshot - wg-quick exits once the interface is up)
def main [
    name: string    # The service name, passed by s6-supervise
] {
    # set executable name - used to make log output more useful
    bf env x_set --override run $name

    # run checks before executing service
    bf write debug "No pre-run checks required."

    # launch WireGuard service
    bf write "Starting WireGuard interface."
    let args = [
        "up"
        (bf env WIREGUARD_CONF)
    ]
    bf-s6 svc launch wg-quick ...$args
}
